<Application x:Class="OgameSkaner.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:OgameSkaner.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:StatusToBrushConverter x:Key="StatusToBrush" />
        <converters:EnumEqualsConverter x:Key="EnumEquals" />
        <converters:NotNullConverter x:Key="NotNull" />

        <SolidColorBrush x:Key="PanelBackground" Color="White" Opacity="0.82" />
        <SolidColorBrush x:Key="SidebarBackground" Color="#101826" Opacity="0.78" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="MinWidth" Value="80" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="3,2" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Background" Value="{StaticResource PanelBackground}" />
        </Style>
        <!--
            Scrolling panels. A panel inside a PanelScroll fills the visible area like before (lists stretch and
            scroll on their own), but never gets smaller than its MinWidth/MinHeight: below that the ScrollViewer
            shows scrollbars instead of squeezing the lists to nothing.
        -->
        <Style x:Key="PanelScroll" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="FillViewport" TargetType="FrameworkElement">
            <Setter Property="Height" Value="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
            <Setter Property="Width" Value="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
        </Style>
        <Style TargetType="GridSplitter">
            <Setter Property="Width" Value="6" />
            <Setter Property="Margin" Value="-6,0,4,10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="ToolTip" Value="Drag to resize" />
        </Style>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Stroke" Value="#555" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,6" />
        </Style>
    </Application.Resources>
</Application>
