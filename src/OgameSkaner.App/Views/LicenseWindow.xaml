<Window x:Class="OgameSkaner.App.Views.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OgameSkaner.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:LicenseViewModel}"
        Title="OgameSkaner license" Height="640" Width="620" MinHeight="480" MinWidth="520"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" Margin="0" Click="Close_Click" />
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
        </DockPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{Binding Status.Text}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Accounts}" Foreground="#555" />
        </StackPanel>

        <GroupBox DockPanel.Dock="Bottom" Header="Activate" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="License key" Margin="0,0,0,2" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Activate" Command="{Binding ActivateCommand}" Margin="6,0,0,0" />
                    <TextBox Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <TextBlock Text="No license server is set up yet: paste a license token below instead." Foreground="#555" Margin="0,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanActivateOnline}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="Machine id (the license is issued for it)" Margin="0,10,0,2" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Copy" Command="{Binding CopyMachineIdCommand}" Margin="6,0,0,0" />
                    <TextBox Text="{Binding MachineId, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" />
                </DockPanel>

                <TextBlock Text="License token" Margin="0,10,0,2" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Import" Command="{Binding ImportCommand}" Margin="6,0,0,0" VerticalAlignment="Top" />
                    <TextBox Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}" Height="54" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                </DockPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Terms of use">
            <DockPanel>
                <CheckBox DockPanel.Dock="Bottom" Content="I have read and accept the terms, and use OgameSkaner at my own risk"
                          IsChecked="{Binding TermsAccepted}" IsEnabled="{Binding TermsOpen}" Margin="0,8,0,0" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding Terms}" TextWrapping="Wrap" />
                </ScrollViewer>
            </DockPanel>
        </GroupBox>
    </DockPanel>
</Window>
