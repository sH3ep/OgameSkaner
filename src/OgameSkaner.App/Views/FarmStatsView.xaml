<UserControl x:Class="OgameSkaner.App.Views.FarmStatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OgameSkaner.App.ViewModels"
             xmlns:infra="clr-namespace:OgameSkaner.App.Infrastructure"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:FarmStatsViewModel}"
             d:DesignHeight="560" d:DesignWidth="1000">
    <GroupBox Header="Raid target statistics">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <CheckBox Content="Top only" IsChecked="{Binding TopOnly}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <CheckBox Content="High value only" IsChecked="{Binding HighValueOnly}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <CheckBox Content="Low resource only" IsChecked="{Binding BannedOnly}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="Lift ban" Command="{Binding LiftBansCommand}" MinWidth="0"
                            ToolTip="The ticked planets marked low resource are spied on again (the ban stays in the history, so a new one lasts the longer time)" />
                    <Button Content="↻" Command="{Binding RefreshCommand}" MinWidth="0" Padding="8,2" ToolTip="Read the statistics again (the database only, no game requests)" />
                </StackPanel>
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
            </DockPanel>

            <DataGrid infra:Layout.Key="FarmStats.Targets" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" HeadersVisibility="Column" SelectionUnit="FullRow" Background="Transparent" IsReadOnly="False"
                      EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" SortMemberPath="IsSelected">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="★" Binding="{Binding Top}" IsReadOnly="True" Foreground="#C08000" />
                    <DataGridTextColumn Header="Player" Binding="{Binding PlayerName}" IsReadOnly="True" MinWidth="110" />
                    <DataGridTextColumn Header="Rank" Binding="{Binding Rank, StringFormat=N0}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Coordinates" Binding="{Binding Coordinates}" SortMemberPath="CoordinatesSortKey" IsReadOnly="True" />
                    <DataGridTextColumn Header="Reports" Binding="{Binding Reports}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Last report" Binding="{Binding LastReport}" SortMemberPath="LastReportSortKey" IsReadOnly="True" />
                    <DataGridTextColumn Header="Last stock" Binding="{Binding LastResources, StringFormat=N0}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Median stock" Binding="{Binding MedianResources, StringFormat=N0}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Refill / h" Binding="{Binding RefillPerHour, StringFormat=N0}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Score" Binding="{Binding Score, StringFormat=N0}" IsReadOnly="True" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="Attacks" Binding="{Binding Attacks}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Loot taken (est.)" Binding="{Binding LootTaken, StringFormat=N0}" IsReadOnly="True" />
                    <DataGridTextColumn Header="High value" Binding="{Binding HighValue}" IsReadOnly="True" MinWidth="100" />
                    <DataGridTextColumn Header="Low resource" Binding="{Binding Ban}" IsReadOnly="True" MinWidth="120" />
                    <DataGridTextColumn Header="Raider state" Binding="{Binding State}" IsReadOnly="True" Width="*" MinWidth="120" />
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBanned}" Value="True">
                                <Setter Property="Foreground" Value="#999" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </DockPanel>
    </GroupBox>
</UserControl>
