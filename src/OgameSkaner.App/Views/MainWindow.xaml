<Window x:Class="OgameSkaner.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OgameSkaner.App.ViewModels"
        xmlns:infra="clr-namespace:OgameSkaner.App.Infrastructure"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="OgameSkaner" Height="760" Width="1200" MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterScreen" infra:Layout.Key="MainWindow">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/Resources/background.jpg" Stretch="UniformToFill" />
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <DockPanel Background="{StaticResource SidebarBackground}">
            <StackPanel DockPanel.Dock="Top" Margin="10">
                <TextBlock Text="Universe" Foreground="White" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                          DisplayMemberPath="Name" Margin="0,0,0,6" />
                <Button Content="Manage universes…" Command="{Binding ManageProfilesCommand}" Margin="0,0,0,16" />

                <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                         Background="Transparent" BorderThickness="0"
                         Foreground="White" FontSize="15">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Ellipse DockPanel.Dock="Right" Width="9" Height="9" Fill="LimeGreen" Margin="8,0,0,0" VerticalAlignment="Center"
                                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" ToolTip="Running" />
                                <TextBlock Text="{Binding Title}" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="10" VerticalAlignment="Bottom">
                <TextBlock Text="Attack protection" Foreground="White" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,8,0"
                             Fill="{Binding Defense.ProtectionStatus, Converter={StaticResource StatusToBrush}}" />
                    <TextBlock Text="{Binding Defense.ProtectionText}" Foreground="White" TextWrapping="Wrap" MaxWidth="130"
                               ToolTip="The Defense page shows the incoming fleets and the log" />
                </StackPanel>
                <Button Content="Stop alarm" Command="{Binding Alarm.StopCommand}" HorizontalAlignment="Left" Margin="0,0,0,6"
                        Visibility="{Binding Alarm.IsPlaying, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Silence the alarm playing now; a new attack plays it again" />
                <Border Height="6" />
                <TextBlock Text="Queue" Foreground="White" Margin="0,0,0,4" />
                <TextBlock Text="{Binding Queue.Summary}" Foreground="#99FFFFFF" TextWrapping="Wrap" Margin="0,0,0,12"
                           ToolTip="What the action queue does now; the Queue page shows every group" />
                <TextBlock Text="{Binding Now, StringFormat='{}{0:HH:mm:ss}'}" Foreground="White" FontSize="20" Margin="0,0,0,2" />
                <TextBlock Text="{Binding Now, StringFormat='{}{0:d}'}" Foreground="#99FFFFFF" Margin="0,0,0,12" />
                <TextBlock Text="Session" Foreground="White" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,8,0"
                             Fill="{Binding SessionStatus, Converter={StaticResource StatusToBrush}}" />
                    <TextBlock Text="{Binding SessionStatusText}" Foreground="White" TextWrapping="Wrap" MaxWidth="130" />
                </StackPanel>
                <Button Content="Check now" Command="{Binding CheckSessionCommand}" HorizontalAlignment="Left" Margin="0,6,0,12" />
                <TextBlock Text="License" Foreground="White" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,8,0"
                             Fill="{Binding LicenseStatus, Converter={StaticResource StatusToBrush}}" />
                    <TextBlock Text="{Binding LicenseText}" Foreground="White" TextWrapping="Wrap" MaxWidth="130" />
                </StackPanel>
                <Button Content="License…" Command="{Binding ShowLicenseCommand}" HorizontalAlignment="Left" Margin="0,6,0,12"
                        ToolTip="Activate, import a license token or read the terms" />
                <TextBlock Text="sH3ep @2019" Foreground="#99FFFFFF" />
            </StackPanel>
        </DockPanel>

        <!-- Page content, view chosen by the page DataTemplates registered in App -->
        <ContentControl Grid.Column="1" Margin="12" Content="{Binding CurrentPage}" />
    </Grid>
</Window>
