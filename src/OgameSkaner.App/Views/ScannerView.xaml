<UserControl x:Class="OgameSkaner.App.Views.ScannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OgameSkaner.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ScannerViewModel}"
             d:DesignHeight="450" d:DesignWidth="760">
    <ScrollViewer Style="{StaticResource PanelScroll}" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Scan galaxy" VerticalAlignment="Top">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Text="From galaxy" VerticalAlignment="Center" Margin="0,0,6,6" />
                        <TextBox Grid.Column="1" Text="{Binding StartGalaxy}" />
                        <TextBlock Grid.Column="2" Text="system" VerticalAlignment="Center" Margin="0,0,6,6" />
                        <TextBox Grid.Column="3" Text="{Binding StartSystem}" />

                        <TextBlock Grid.Row="1" Text="To galaxy" VerticalAlignment="Center" Margin="0,0,6,6" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EndGalaxy}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="system" VerticalAlignment="Center" Margin="0,0,6,6" />
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding EndSystem}" />
                    </Grid>

                    <TextBlock Text="Systems from..to are scanned in every galaxy of the range."
                               Foreground="#555" TextWrapping="Wrap" Margin="0,2,0,8" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Delay between systems" VerticalAlignment="Center" Margin="0,0,6,6" />
                        <TextBox Grid.Column="1" Text="{Binding MinDelayMilliseconds, Converter={StaticResource GroupedNumber}}"
                                 ToolTip="Shortest time between the requests of two systems, in ms. Each delay is picked at random between the two values. 0 = only the app's minimum gap between requests (Ogamex:MinRequestInterval, 400 ms + up to 200 ms), which is always kept." />
                        <TextBlock Grid.Column="2" Text="–" VerticalAlignment="Center" Margin="6,0,6,6" />
                        <TextBox Grid.Column="3" Text="{Binding MaxDelayMilliseconds, Converter={StaticResource GroupedNumber}}"
                                 ToolTip="Longest time between the requests of two systems, in ms." />
                        <TextBlock Grid.Column="4" Text="ms" VerticalAlignment="Center" Margin="6,0,6,6" />

                        <TextBlock Grid.Row="1" Text="Pause after every" VerticalAlignment="Center" Margin="0,0,6,6" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PauseEverySystems, Converter={StaticResource GroupedNumber}}"
                                 ToolTip="A longer pause after this many systems. 0 = no pauses." />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="systems for" VerticalAlignment="Center" Margin="6,0,6,6" />
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding MinPauseSeconds, Converter={StaticResource GroupedNumber}}"
                                 ToolTip="Shortest pause, in seconds." />
                        <TextBlock Grid.Row="1" Grid.Column="4" Text="–" VerticalAlignment="Center" Margin="6,0,6,6" />
                        <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding MaxPauseSeconds, Converter={StaticResource GroupedNumber}}"
                                 ToolTip="Longest pause, in seconds; each pause is picked at random between the two." />
                        <TextBlock Grid.Row="1" Grid.Column="6" Text="s" VerticalAlignment="Center" Margin="6,0,0,6" />
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Scan" Command="{Binding ScanCommand}" />
                        <Button Content="Cancel" Command="{Binding ScanCancelCommand}" />
                    </StackPanel>

                    <ProgressBar Height="18" Margin="0,4,0,6"
                                 Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}" />
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Session" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="gameAuthToken" Margin="0,0,0,2" />
                    <TextBox Text="{Binding AuthToken, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="SessionId" Margin="0,0,0,2" />
                    <TextBox Text="{Binding SessionId, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Save session" Command="{Binding SaveSessionCommand}" HorizontalAlignment="Left" />
                    <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,6,0,0">
                        Log in to the universe in your browser, open the developer tools (F12) →
                        Application → Cookies, and copy the values of the
                        <Bold>gameAuthToken</Bold> and <Bold>SessionId</Bold> cookies here.
                        You can keep playing in the browser at the same time.
                    </TextBlock>
                </StackPanel>
            </GroupBox>
        </Grid>
    </ScrollViewer>
</UserControl>
