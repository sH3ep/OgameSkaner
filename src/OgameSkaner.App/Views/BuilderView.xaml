<UserControl x:Class="OgameSkaner.App.Views.BuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OgameSkaner.App.ViewModels"
             xmlns:infra="clr-namespace:OgameSkaner.App.Infrastructure"
             xmlns:views="clr-namespace:OgameSkaner.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:BuilderViewModel}"
             d:DesignHeight="520" d:DesignWidth="900">
    <TabControl>
    <TabItem Header="Planets">
    <Grid infra:Layout.Key="Builder.Main">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="360" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="2*" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <GroupBox Header="Strategy">
            <ScrollViewer Style="{StaticResource PanelScroll}">
                <DockPanel Style="{StaticResource FillViewport}" MinHeight="330" MinWidth="380">
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Reference level" VerticalAlignment="Center" Margin="0,0,6,6" />
                        <TextBox Grid.Column="1" Text="{Binding ReferenceLevel, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" Text="Solar plant max level" VerticalAlignment="Center" Margin="10,0,6,6" />
                        <TextBox Grid.Column="3" Text="{Binding SolarMaxLevel, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Highest solar plant level the simulation may build (it also uses solar satellites when allowed); energy always covers the mines when a plan is done" />
                        <TextBlock Grid.Row="1" Text="Mine balance %" VerticalAlignment="Center" Margin="0,0,6,6" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MineBalancePercent, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Keeps the mines level: while the lowest mine's next level costs less than this share of the most expensive mine's next level, it is built first (e.g. no Metal 50 with Crystal 35). Only mines still below their target count. 0 turns it off." />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Storage when full ≥ %" VerticalAlignment="Center" Margin="10,0,6,6" />
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding StorageFillPercent, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="The plan adds a storage level before an item that would leave its resource at this share of capacity or more, so production isn't lost while the queue runs. 0 turns it off." />
                        <TextBlock Grid.Row="2" Text="Robotics early level" VerticalAlignment="Center" Margin="0,0,6,6" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EarlyRoboticsLevel, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="The plan builds the Robotics Factory to this level before any mine goes above the mine level on the right, so everything after builds faster. 0 turns it off." />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="…before mines pass level" VerticalAlignment="Center" Margin="10,0,6,6" />
                        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding EarlyRoboticsMineLevel, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Mines may reach this level; the next mine level waits until Robotics has the early level." />
                    </Grid>
                    <TextBlock DockPanel.Dock="Top" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="Relative: target = reference level + value (e.g. -2). Absolute: target = value. Each check simulates the fastest order from the planet's real state to the targets and queues what the planet can pay. The solar plant, storages, Robotics/Nanite Factory, Shipyard and solar satellites are placed by the simulation (Robotics/Nanite/Shipyard targets are minimum levels); other buildings are built by price afterwards." />

                    <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="↻" MinWidth="0" Padding="6,0" Margin="6,0,0,0"
                                Command="{Binding RefreshViewedPlanetCommand}" ToolTip="Read the selected planet again" />
                        <TextBlock Text="{Binding ViewedPlanetInfo, TargetNullValue='Click a planet in the list on the right to see its levels in the Actual column.'}"
                                   Foreground="#555" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>

                    <DataGrid infra:Layout.Key="Builder.Rules" ItemsSource="{Binding Rules}" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column"
                              SelectionUnit="Cell" Background="Transparent">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="On">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding EnabledToolTip}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Building" Binding="{Binding DisplayName}" IsReadOnly="True" Width="*" MinWidth="140" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Actual" Binding="{Binding Actual}" IsReadOnly="True" Width="55" Foreground="#2b5797" />
                            <DataGridTemplateColumn Header="Mode" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{x:Static vm:BuildingRuleItemViewModel.Modes}"
                                                  SelectedItem="{Binding Mode, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Offset" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsRelative}"
                                                 Margin="0" ToolTip="Relative rules: target = reference level + offset (e.g. 2 or -2)" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Target" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsRelative}"
                                                 Margin="0" ToolTip="Absolute rules: the level to reach. Relative rules: calculated from the reference level">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRelative}" Value="True">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="BorderThickness" Value="0" />
                                                            <Setter Property="Foreground" Value="#555" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </ScrollViewer>
        </GroupBox>

        <GridSplitter Grid.Column="1" />

        <GroupBox Grid.Column="2" Header="Run">
            <ScrollViewer Style="{StaticResource PanelScroll}">
                <DockPanel Style="{StaticResource FillViewport}" MinHeight="330" MinWidth="250">
                    <StackPanel DockPanel.Dock="Top">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" MinWidth="90" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Mode" VerticalAlignment="Center" Margin="0,0,6,4" />
                            <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:BuilderViewModel.Modes}" DisplayMemberPath="Name"
                                      SelectedValuePath="Id" SelectedValue="{Binding Mode}" Margin="0,0,0,4" MinWidth="170"
                                      ToolTip="Simulated: the build simulation finds the fastest order to the targets. By price: always the cheapest next level of the ticked buildings (metal 1, crystal 1.5, deuterium 3), until every target is reached; the solar plant only when energy runs out, storages at the fill % or their target." />
                            <TextBlock Grid.Row="1" Text="Simulations per plan" VerticalAlignment="Center" Margin="0,0,6,4"
                                       IsEnabled="{Binding IsSimulatedMode}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SimulationsPerPlan, Converter={StaticResource GroupedNumber}}" Margin="0,0,0,4"
                                     IsEnabled="{Binding IsSimulatedMode}"
                                     ToolTip="Orders simulated for one plan of one planet (2,000,000 take well under a second per planet)" />
                            <CheckBox Grid.Row="2" Grid.ColumnSpan="2" Content="Use solar satellites for energy" IsChecked="{Binding UseSolarSatellites}"
                                      IsEnabled="{Binding IsSimulatedMode}" ToolTip="Simulated mode only" />
                        </Grid>

                        <Expander Margin="0,0,0,8">
                            <Expander.Header>
                                <CheckBox Content="Share resources between planets" IsChecked="{Binding ShareResources}"
                                          ToolTip="After each check, planets waiting for stock get transports from planets with a surplus. Every planet first keeps what its own next items need; planets the Builder doesn't build on give all they have." />
                            </Expander.Header>
                            <StackPanel Margin="4,4,0,0" IsEnabled="{Binding ShareResources}">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" MinWidth="90" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Next items" VerticalAlignment="Center" Margin="0,0,6,4" />
                                    <TextBox Grid.Column="1" Text="{Binding ShareNextItems, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"
                                             ToolTip="Each planet keeps resources for this many of its next items, and a planet waiting for stock asks for that many" />
                                    <TextBlock Grid.Row="1" Text="Min. transport" VerticalAlignment="Center" Margin="0,0,6,4" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ShareMinTransportAmount, Converter={StaticResource GroupedNumber}}" Margin="0,0,0,4"
                                             ToolTip="Transports carrying less (metal + crystal + deuterium) aren't sent" />
                                    <TextBlock Grid.Row="2" Text="Speed %" VerticalAlignment="Center" Margin="0,0,6,4" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ShareSpeedPercent, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                                    <TextBlock Grid.Row="3" Text="Fleet slots to claim" VerticalAlignment="Center" Margin="0,0,6,4" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ShareMaxSlots, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"
                                             ToolTip="With every fleet slot in use, the sharing claims up to this many: Raids, Asteroids and Moons leave the next free ones to it (the Expeditions' reserved slots stay theirs)" />
                                    <TextBlock Grid.Row="4" Text="Donors keep deuterium" VerticalAlignment="Center" Margin="0,0,6,4" />
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ShareKeepDeuterium, Converter={StaticResource GroupedNumber}}" Margin="0,0,0,4"
                                             ToolTip="Every planet keeps this much deuterium on top of its own needs, as fuel for raids, expeditions and fleet escapes" />
                                </Grid>
                                <DockPanel Margin="0,0,0,4" ToolTip="Ticked ships carry the resources, top to bottom: the first type as far as the planet has it, then the next">
                                    <StackPanel DockPanel.Dock="Right" Margin="4,0,0,0">
                                        <Button Content="▲" Command="{Binding MoveShareCargoShipUpCommand}" Padding="6,0" Margin="0,0,0,2" MinWidth="0" ToolTip="Higher priority" />
                                        <Button Content="▼" Command="{Binding MoveShareCargoShipDownCommand}" Padding="6,0" MinWidth="0" ToolTip="Lower priority" />
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding ShareCargoShips}" SelectedItem="{Binding SelectedShareCargoShip}" MaxHeight="80">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:CargoShipOptionViewModel}">
                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                                <CheckBox Content="Test mode (log the transports, send none)" IsChecked="{Binding ShareTestMode}"
                                          ToolTip="Not saved; applies to the next start" />
                            </StackPanel>
                        </Expander>

                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshPlanetsCommand}" Margin="0" MinWidth="0" Padding="8,2"
                                    ToolTip="Reads your planets from the game and stores them (also done before every run)" />
                            <Button DockPanel.Dock="Right" Content="None" Command="{Binding SelectNoPlanetsCommand}" Margin="0,0,4,0" MinWidth="0" Padding="8,2" />
                            <Button DockPanel.Dock="Right" Content="All" Command="{Binding SelectAllPlanetsCommand}" Margin="0,0,4,0" MinWidth="0" Padding="8,2" />
                            <TextBlock Text="Planets" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <ListBox ItemsSource="{Binding Planets}" SelectedItem="{Binding ViewedPlanet}" MaxHeight="180" Margin="0,0,0,2"
                                 HorizontalContentAlignment="Stretch"
                                 ToolTip="Tick the planets to automate; click a planet to see its levels in the Actual column">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PlanetSelectionItemViewModel}">
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                  ToolTip="Run automation on this planet" />
                                        <TextBlock Text="{Binding Name}" Width="120" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Coordinates}" Foreground="#555" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{Binding PlanetsInfo}" Foreground="#555" Margin="0,0,0,6"
                                   ToolTip="New planets are ticked automatically; unticked planets are remembered" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Start" Command="{Binding RunCommand}" />
                            <Button Content="Stop" Command="{Binding RunCancelCommand}" />
                            <Button Content="Check now" Command="{Binding CheckNowCommand}" IsEnabled="{Binding RunCommand.IsRunning}"
                                    ToolTip="Start the next check now instead of waiting for the time in the log" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Log}" MinHeight="60" />
                </DockPanel>
            </ScrollViewer>
        </GroupBox>
    </Grid>
    </TabItem>
    <TabItem Header="Moons">
        <views:MoonsView DataContext="{Binding Moons}" />
    </TabItem>
    </TabControl>
</UserControl>
