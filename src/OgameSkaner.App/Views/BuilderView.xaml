<UserControl x:Class="OgameSkaner.App.Views.BuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OgameSkaner.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:BuilderViewModel}"
             d:DesignHeight="520" d:DesignWidth="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <GroupBox Header="Strategy">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Reference level" VerticalAlignment="Center" Margin="0,0,6,6" />
                    <TextBox Grid.Column="1" Text="{Binding ReferenceLevel, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" Text="Solar plant max level" VerticalAlignment="Center" Margin="10,0,6,6" />
                    <TextBox Grid.Column="3" Text="{Binding SolarMaxLevel, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="The solar plant is built by energy, not price: when the planet is short of energy or the next mine would make it short" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Storage when full ≥ %" VerticalAlignment="Center" Margin="10,0,6,6" />
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding StorageFillPercent, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="A storage is queued first when its resource is at this share of capacity or more (one level at a time). 0 turns it off." />
                </Grid>
                <TextBlock DockPanel.Dock="Top" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Relative: target = reference level + value (e.g. -2). Absolute: target = value. The cheapest upgrade below its target is queued first (value = metal + 1.5×crystal + 3×deuterium). Only upgrades the planet can pay for right now are queued; locked buildings are skipped. The solar plant and storages are automatic." />

                <DataGrid ItemsSource="{Binding Rules}" AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column"
                          SelectionUnit="Cell" Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="On">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Building" Binding="{Binding DisplayName}" IsReadOnly="True" Width="*" />
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="Mode" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{x:Static vm:BuildingRuleItemViewModel.Modes}"
                                              SelectedItem="{Binding Mode, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Offset" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsRelative}"
                                             Margin="0" ToolTip="Relative rules: target = reference level + offset (e.g. 2 or -2)" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Target" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsRelative}"
                                             Margin="0" ToolTip="Absolute rules: the level to reach. Relative rules: calculated from the reference level">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRelative}" Value="True">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Setter Property="Foreground" Value="#555" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <GroupBox Grid.Column="1" Header="Run">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Mode" FontWeight="SemiBold" Margin="0,0,0,2" />
                    <RadioButton Content="Single – fill free queue slots once per planet" Margin="0,0,0,2"
                                 IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Single}" />
                    <RadioButton Content="Auto – one item per planet per pass until all are done" Margin="0,0,0,8"
                                 IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Auto}" />

                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshPlanetsCommand}" Margin="0" MinWidth="60"
                                ToolTip="Reads your planets from the game and stores them (also done before every run)" />
                        <Button DockPanel.Dock="Right" Content="None" Command="{Binding SelectNoPlanetsCommand}" Margin="0,0,4,0" MinWidth="50" />
                        <Button DockPanel.Dock="Right" Content="All" Command="{Binding SelectAllPlanetsCommand}" Margin="0,0,4,0" MinWidth="50" />
                        <TextBlock Text="Planets" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border BorderBrush="#BBB" BorderThickness="1" MaxHeight="180" Margin="0,0,0,2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Planets}" Margin="4,2">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PlanetSelectionItemViewModel}">
                                        <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" Width="140" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Coordinates}" Foreground="#555" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <TextBlock Text="{Binding PlanetsInfo}" Foreground="#555" Margin="0,0,0,6"
                               ToolTip="New planets are ticked automatically; unticked planets are remembered" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Start" Command="{Binding RunCommand}" />
                        <Button Content="Stop" Command="{Binding RunCancelCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Log}" />
            </DockPanel>
        </GroupBox>
    </Grid>
</UserControl>
