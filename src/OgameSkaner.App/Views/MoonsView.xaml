<UserControl x:Class="OgameSkaner.App.Views.MoonsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OgameSkaner.App.ViewModels"
             xmlns:infra="clr-namespace:OgameSkaner.App.Infrastructure"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MoonsViewModel}"
             d:DesignHeight="560" d:DesignWidth="900">
    <Grid infra:Layout.Key="Moons.Main">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="360" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="2*" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <GroupBox Header="Moons and build plan">
            <ScrollViewer Style="{StaticResource PanelScroll}">
                <StackPanel MinWidth="340">
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" Margin="0" MinWidth="0" Padding="8,2"
                                ToolTip="Reads your planets and moons from the game" />
                        <Button DockPanel.Dock="Right" Content="None" Command="{Binding SelectNoMoonsCommand}" Margin="0,0,4,0" MinWidth="0" Padding="8,2" />
                        <Button DockPanel.Dock="Right" Content="All" Command="{Binding SelectAllMoonsCommand}" Margin="0,0,4,0" MinWidth="0" Padding="8,2" />
                        <TextBlock Text="Moons" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Moons}" MaxHeight="150" Margin="0,0,0,8"
                             ToolTip="The automation builds on the ticked moons; new moons come unticked">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PlanetSelectionItemViewModel}">
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Name}" Width="110" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Coordinates}" Foreground="#555" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Build mode" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <RadioButton Content="Simulation: the shortest time to the targets" IsChecked="{Binding IsSimulation}" GroupName="MoonMode" Margin="0,0,0,4"
                                 ToolTip="Moons produce nothing, so only time counts: Robot Factory and Nanite Factory first when they save time, the Moon Base whenever fields run out, then the quickest level" />
                    <RadioButton Content="Schema: the steps below in their order" IsChecked="{Binding IsSchema}" GroupName="MoonMode" Margin="0,0,0,6" />

                    <TextBlock Text="Targets (simulation)" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Targets}" IsEnabled="{Binding IsSimulation}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MoonTargetItemViewModel}">
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="{Binding Name}" Width="140" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding Level, UpdateSourceTrigger=PropertyChanged}" Width="60" HorizontalAlignment="Left" Margin="0" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Schema steps" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <DockPanel IsEnabled="{Binding IsSchema}" Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddStepCommand}" Margin="0" MinWidth="0" Padding="8,2" />
                        <TextBox DockPanel.Dock="Right" Text="{Binding NewStepLevel, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="4,0,4,0"
                                 ToolTip="Reach this level" />
                        <ComboBox ItemsSource="{Binding MoonBuildings}" SelectedItem="{Binding NewStepBuilding}" DisplayMemberPath="DisplayName" />
                    </DockPanel>
                    <DockPanel IsEnabled="{Binding IsSchema}" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Margin="4,0,0,0">
                            <Button Content="▲" Command="{Binding MoveStepUpCommand}" Padding="6,0" Margin="0,0,0,2" />
                            <Button Content="▼" Command="{Binding MoveStepDownCommand}" Padding="6,0" Margin="0,0,0,2" />
                            <Button Content="✕" Command="{Binding RemoveStepCommand}" Padding="6,0" ToolTip="Remove the step" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding SchemaSteps}" SelectedItem="{Binding SelectedStep}" MinHeight="80" MaxHeight="200"
                                 ToolTip="Built top to bottom; a step whose requirement or field is missing stops the plan" />
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>

        <GridSplitter Grid.Column="1" />

        <GroupBox Grid.Column="2" Header="Transport, new moons and run">
            <ScrollViewer Style="{StaticResource PanelScroll}">
                <DockPanel Style="{StaticResource FillViewport}" MinHeight="420" MinWidth="260">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Transport from the moon's planet" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="70" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Bring for (h)" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <TextBox Grid.Column="1" Text="{Binding HorizonHours, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="A transport brings only what this many hours of the moon's construction need (the queue and the plan's next levels), minus what the moon has and what's on its way: moons are unguarded" />
                            <TextBlock Grid.Row="1" Text="Speed %" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TransportSpeedPercent, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="2" Text="Check every (min)" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CheckIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="The automation looks at the moons at least this often (sooner when a queue item ends or a transport lands)" />
                            <TextBlock Grid.Row="3" Text="Game queue depth" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MaxServerQueueDepth, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="At most this many items in a moon's game queue; an item is queued only when the moon can pay it on top of the waiting ones" />
                        </Grid>
                        <CheckBox Content="Send transports automatically" IsChecked="{Binding AutoTransport}" Margin="0,0,0,4"
                                  ToolTip="While running, each moon gets its planet's cargo ships with what it needs" />
                        <DockPanel Margin="0,0,0,6" ToolTip="Ticked ships carry the resources, top to bottom: the first type as far as the planet has it, then the next">
                            <StackPanel DockPanel.Dock="Right" Margin="4,0,0,0">
                                <Button Content="▲" Command="{Binding MoveCargoShipUpCommand}" Padding="6,0" Margin="0,0,0,2" ToolTip="Higher priority" />
                                <Button Content="▼" Command="{Binding MoveCargoShipDownCommand}" Padding="6,0" ToolTip="Lower priority" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding CargoShips}" SelectedItem="{Binding SelectedCargoShip}" MaxHeight="110">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CargoShipOptionViewModel}">
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                        <Button Content="Send resources now" Command="{Binding TransportNowCommand}" HorizontalAlignment="Left" Margin="0,0,0,10"
                                ToolTip="For each ticked moon: queue what it can pay and send what the next hours still need" />

                        <TextBlock Text="Create moons" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ListBox ItemsSource="{Binding PlanetsWithoutMoon}" MaxHeight="130" Margin="0,0,0,4"
                                 ToolTip="Planets without a moon; tick the ones to create a moon on">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PlanetSelectionItemViewModel}">
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Name}" Width="100" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Coordinates}" Foreground="#555" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <DockPanel Margin="0,0,0,2">
                            <TextBlock Text="Moon size (km)" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <TextBox Text="{Binding CreateDiameter, Converter={StaticResource GroupedNumber}}"
                                     ToolTip="1,000–9,999 km; the size decides the metal cost, and above 1,799 km it needs Graviton Research (one level per 600 km)" />
                        </DockPanel>
                        <TextBlock Text="{Binding CreateCostText}" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,4" />
                        <Button Content="Create moons" Command="{Binding CreateMoonsCommand}" HorizontalAlignment="Left" Margin="0,0,0,10"
                                ToolTip="Creates a moon of this size on every ticked planet, paid with that planet's metal (asks first)" />

                        <CheckBox Content="Test mode (don't queue, send or create)" IsChecked="{Binding TestMode}" Margin="0,0,0,6" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Start" Command="{Binding RunCommand}"
                                    ToolTip="Build on the ticked moons and send transports, and repeat" />
                            <Button Content="Stop" Command="{Binding RunCancelCommand}" />
                            <Button Content="Check now" Command="{Binding CheckNowCommand}" IsEnabled="{Binding RunCommand.IsRunning}"
                                    ToolTip="Start the next check now instead of waiting for the time in the log" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Log}" MinHeight="60" />
                </DockPanel>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</UserControl>
