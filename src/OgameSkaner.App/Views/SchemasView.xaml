<UserControl x:Class="OgameSkaner.App.Views.SchemasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OgameSkaner.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SchemasViewModel}"
             d:DesignHeight="620" d:DesignWidth="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="11*" />
            <ColumnDefinition Width="9*" />
        </Grid.ColumnDefinitions>

        <!-- Library and editor -->
        <GroupBox Header="Schemas">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Content="Delete" Command="{Binding DeleteSchemaCommand}" MinWidth="60" Margin="0,0,0,6" />
                    <Button DockPanel.Dock="Right" Content="Duplicate" Command="{Binding DuplicateSchemaCommand}" MinWidth="70" />
                    <Button DockPanel.Dock="Right" Content="New" Command="{Binding NewSchemaCommand}" MinWidth="50" />
                    <ComboBox ItemsSource="{Binding Schemas}" SelectedItem="{Binding SelectedSchema}" Margin="0,0,6,6">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SchemaItemViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text="{Binding Summary, StringFormat='  ({0})'}" Foreground="#777" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </DockPanel>

                <Grid DockPanel.Dock="Top" DataContext="{Binding SelectedSchema}" IsEnabled="{Binding Converter={StaticResource NotNull}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="55" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="55" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="55" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,6,6" />
                    <TextBox Grid.Column="1" Grid.ColumnSpan="5" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Delay=300}" />

                    <TextBlock Grid.Row="1" Text="Solar plant max" VerticalAlignment="Center" Margin="0,0,6,6" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SolarMaxLevel, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="The solar plant is raised up to this level whenever energy would run out" />
                    <CheckBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Content="then solar satellites" IsChecked="{Binding UseSolarSatellites}"
                              VerticalAlignment="Center" Margin="10,0,6,6"
                              ToolTip="With the solar plant at its maximum and energy short, order solar satellites (needs a shipyard)" />
                    <TextBlock Grid.Row="1" Grid.Column="4" Text="Storage at %" VerticalAlignment="Center" Margin="10,0,6,6" />
                    <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding StorageFillPercent, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Queue a storage when its resource reaches this share of capacity; 0 turns it off" />

                    <TextBlock Grid.Row="2" Text="Robotics max" VerticalAlignment="Center" Margin="0,0,6,6" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RoboticsMaxLevel, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Robotics Factory levels are added when they pay back in construction time, up to this level (0 = never)" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Nanite max" VerticalAlignment="Center" Margin="10,0,6,6" />
                    <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding NaniteMaxLevel, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Nanite Factory levels are added when they pay back, up to this level (0 = never; needs Robotics 10 and Computer Technology 10)" />
                    <TextBlock Grid.Row="2" Grid.Column="4" Text="Queue depth" VerticalAlignment="Center" Margin="10,0,6,6" />
                    <TextBox Grid.Row="2" Grid.Column="5" Text="{Binding MaxServerQueueDepth, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Items kept in the game's queue (running one included). The game drops items it can't pay when their turn comes, so keep it small." />
                </Grid>

                <TextBlock DockPanel.Dock="Top" Text="Click a building to add its next level:" Foreground="#555" Margin="0,4,0,2" />
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Palette}" Margin="0,0,0,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding DisplayName}" MinWidth="0" Padding="6,2" Margin="0,0,4,4"
                                    Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Type}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel DockPanel.Dock="Right" Margin="6,0,0,0">
                    <Button Content="▲ Up" Command="{Binding MoveStepUpCommand}" MinWidth="70" />
                    <Button Content="▼ Down" Command="{Binding MoveStepDownCommand}" MinWidth="70" />
                    <Button Content="Remove" Command="{Binding RemoveStepCommand}" MinWidth="70" />
                </StackPanel>
                <ListBox ItemsSource="{Binding SelectedSchema.Steps}" SelectedItem="{Binding SelectedStep}"
                         ToolTip="Build order (absolute levels). Marks for the planet clicked on the right: ✓ built, ⏳ queued, ▶ next">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SchemaStepItemViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Mark}" Width="18" Foreground="#2b7a2b" />
                                <TextBlock Text="{Binding Text}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </GroupBox>

        <!-- Planets and runner -->
        <GroupBox Grid.Column="1" Header="Run">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshPlanetsCommand}" Margin="0" MinWidth="60"
                                ToolTip="Reads your planets from the game (also done in every cycle of a run)" />
                        <TextBlock Text="Planets" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Planets}" SelectedItem="{Binding ViewedPlanet}" MaxHeight="220" Margin="0,0,0,2"
                             HorizontalContentAlignment="Stretch"
                             ToolTip="Tick the planets to run, pick their schema; click a planet to see its progress">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SchemaPlanetItemViewModel}">
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Run the schema on this planet" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Coordinates}" Foreground="#555" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding DataContext.Schemas, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                              SelectedItem="{Binding Schema}" DisplayMemberPath="Name" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Status}" Foreground="#2b5797"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding PlanetsInfo}" Foreground="#555" Margin="0,0,0,4" />
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="↻" MinWidth="0" Padding="6,0" Margin="6,0,0,0"
                                Command="{Binding RefreshViewedPlanetCommand}" ToolTip="Read the selected planet again" />
                        <TextBlock Text="{Binding ViewedPlanetInfo, TargetNullValue='Click a planet to see its progress in the step list.'}"
                                   Foreground="#555" TextWrapping="Wrap" />
                    </DockPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Check every" VerticalAlignment="Center" Margin="0,0,6,6" />
                        <TextBox Width="40" Text="{Binding CheckIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="min" VerticalAlignment="Center" Margin="0,0,12,6" />
                        <Button Content="Start" Command="{Binding RunCommand}" />
                        <Button Content="Stop" Command="{Binding RunCancelCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Log}" />
            </DockPanel>
        </GroupBox>
    </Grid>
</UserControl>
