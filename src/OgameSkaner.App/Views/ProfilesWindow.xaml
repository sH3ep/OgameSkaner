<Window x:Class="OgameSkaner.App.Views.ProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OgameSkaner.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ProfilesViewModel}"
        Title="Universes" Height="340" Width="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" IsDefault="True" Margin="0" Click="Close_Click" />
            <Button Content="Import from old version…" Command="{Binding ImportLegacyCommand}" HorizontalAlignment="Left" Margin="0"
                    ToolTip="Import universes, session and scan results from the folder of the old OgameSkaner (with GamesConfiguration.xml)" />
        </DockPanel>

        <ListBox DockPanel.Dock="Left" Width="150" Margin="0,0,10,0"
                 ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" />

        <StackPanel>
            <TextBlock Text="Name (sub-domain of ogamex.net)" Margin="0,0,0,2" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="{Binding Name, StringFormat='https://{0}.ogamex.net'}" Foreground="#555" Margin="0,0,0,8" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Galaxies" Margin="0,0,0,2" />
                    <TextBox Text="{Binding Galaxies}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Systems per galaxy" Margin="0,0,0,2" />
                    <TextBox Text="{Binding Systems}" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="New" Command="{Binding NewCommand}" />
                <Button Content="Save" Command="{Binding SaveCommand}" />
                <Button Content="Delete" Command="{Binding DeleteCommand}" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
