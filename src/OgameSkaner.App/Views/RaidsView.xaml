<UserControl x:Class="OgameSkaner.App.Views.RaidsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OgameSkaner.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:RaidsViewModel}"
             d:DesignHeight="560" d:DesignWidth="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="460" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <GroupBox Header="Inactive planets">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Content="↻" MinWidth="0" Padding="8,2" Command="{Binding RefreshTargetsCommand}"
                            ToolTip="Evaluate the galaxy database and the stored reports again" />
                    <CheckBox DockPanel.Dock="Right" Content="Hide rejected" IsChecked="{Binding HideRejected}" VerticalAlignment="Center" Margin="0,0,10,6"
                              ToolTip="Show only planets to spy on, waiting for a report, ready or under attack" />
                    <TextBlock Text="{Binding TargetsInfo}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,0,6" />
                </DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="Galaxy" VerticalAlignment="Center" Margin="0,0,6,6" />
                    <TextBox Width="36" Text="{Binding GalaxyFrom, UpdateSourceTrigger=PropertyChanged, Delay=250, TargetNullValue=''}" />
                    <TextBlock Text="–" VerticalAlignment="Center" Margin="0,0,6,6" />
                    <TextBox Width="36" Text="{Binding GalaxyTo, UpdateSourceTrigger=PropertyChanged, Delay=250, TargetNullValue=''}" />
                    <TextBlock Text="System" VerticalAlignment="Center" Margin="10,0,6,6" />
                    <TextBox Width="44" Text="{Binding SystemFrom, UpdateSourceTrigger=PropertyChanged, Delay=250, TargetNullValue=''}" />
                    <TextBlock Text="–" VerticalAlignment="Center" Margin="0,0,6,6" />
                    <TextBox Width="44" Text="{Binding SystemTo, UpdateSourceTrigger=PropertyChanged, Delay=250, TargetNullValue=''}" />
                    <TextBlock Text="Def. rank ≤" VerticalAlignment="Center" Margin="10,0,6,6" />
                    <TextBox Width="60" Text="{Binding MaxRankingDefensePoints, UpdateSourceTrigger=PropertyChanged, Delay=250, TargetNullValue=''}"
                             ToolTip="Show only players with at most this many defense points in the ranking (0 = no defenses). Players not in the ranking are hidden while this is set. Empty = no limit." />
                </WrapPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Button Content="Select ready" Command="{Binding SelectReadyCommand}" MinWidth="0" />
                    <Button Content="Select to spy" Command="{Binding SelectNeedingSpyCommand}" MinWidth="0" />
                    <Button Content="Load reports" Command="{Binding ReadReportsCommand}" MinWidth="0"
                            ToolTip="Load every espionage report from the game's messages, with ships and defenses. Reported planets show up here even before the galaxy is scanned." />
                    <Button Content="Defense ranking" Command="{Binding ReadDefenseRankingCommand}" MinWidth="0"
                            ToolTip="{Binding DefenseRankingInfo}" />
                    <Button Content="Spy selected" Command="{Binding SpySelectedCommand}" MinWidth="0"
                            ToolTip="Send the configured number of probes from the current planet to each selected planet (as far as free fleet slots allow)" />
                    <Button Content="Attack selected" Command="{Binding AttackSelectedCommand}" MinWidth="0"
                            ToolTip="Attack the selected planets that have a report, with the cargo ships their loot needs" />
                </StackPanel>

                <DataGrid ItemsSource="{Binding Targets}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" SelectionUnit="FullRow" Background="Transparent" IsReadOnly="False"
                          EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" SortMemberPath="IsSelected">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Player" Binding="{Binding PlayerName}" IsReadOnly="True" Width="*" MinWidth="110" />
                        <DataGridTextColumn Header="Rank" Binding="{Binding Rank, StringFormat=N0}" IsReadOnly="True" />
                        <DataGridTextColumn Header="" Binding="{Binding Status}" IsReadOnly="True" Foreground="#555" />
                        <DataGridTextColumn Header="Coordinates" Binding="{Binding Coordinates}" SortMemberPath="CoordinatesSortKey" IsReadOnly="True" />
                        <DataGridTextColumn Header="Report" Binding="{Binding ReportAge}" SortMemberPath="ReportAgeSortKey" IsReadOnly="True" />
                        <DataGridTextColumn Header="Resources" Binding="{Binding Resources, StringFormat=N0}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Defense" Binding="{Binding DefensePoints, StringFormat=N0}" IsReadOnly="True" />
                        <DataGridTextColumn Binding="{Binding RankingDefensePoints, StringFormat=N0}" IsReadOnly="True">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Def. rank" ToolTip="Defense points from the game's ranking (1 point per 1,000 resources of defenses). 0 = no defenses: safe to attack, even without a report." />
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RankingDefensePoints}" Value="0">
                                            <Setter Property="Foreground" Value="Green" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Fleet" Binding="{Binding FleetPoints, StringFormat=N0}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Loot" Binding="{Binding Loot, StringFormat=N0}" IsReadOnly="True" />
                        <DataGridTextColumn Header="State" Binding="{Binding StateText}" IsReadOnly="True" MinWidth="90" />
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ToolTip" Value="{Binding Units}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Ready">
                                    <Setter Property="Background" Value="#DFF0D8" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="UnderAttack">
                                    <Setter Property="Background" Value="#FCF8E3" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <GridSplitter Grid.Column="1" />

        <GroupBox Grid.Column="2" Header="Raider">
            <ScrollViewer Style="{StaticResource PanelScroll}">
                <DockPanel Style="{StaticResource FillViewport}" MinHeight="420" MinWidth="260">
                    <StackPanel DockPanel.Dock="Top">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="90" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Max defense points" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <TextBox Grid.Column="1" Text="{Binding MaxDefensePoints, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Attack only planets whose defenses are worth at most this many points (the number the report shows next to Defenses). 0 = no defense at all." />
                            <TextBlock Grid.Row="1" Text="Max fleet points" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MaxFleetPoints, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Attack only planets whose ships are worth at most this many points (the number the report shows next to Ships)" />
                            <TextBlock Grid.Row="2" Text="Min loot" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MinLoot, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                     ToolTip="Don't send attacks that bring less than this (metal + crystal + deuterium)" />
                            <TextBlock Grid.Row="3" Text="Loot %" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding LootPercent, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Share of the planet's resources an attack takes" />
                            <TextBlock Grid.Row="4" Text="Cargo ship" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{x:Static vm:RaidsViewModel.CargoShips}" DisplayMemberPath="Name"
                                      SelectedValuePath="Id" SelectedValue="{Binding CargoShipType}" Margin="0,0,6,6" />
                            <TextBlock Grid.Row="5" Text="Extra cargo %" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding CargoMarginPercent, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Ships for this much more than the expected loot (production during the flight)" />
                            <TextBlock Grid.Row="6" Text="Probes per spy" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding ProbeCount, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="More probes reveal more (ships, defenses); planets whose defenses stay hidden show as Unseen" />
                            <TextBlock Grid.Row="7" Text="Report valid (min)" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding ReportMaxAgeMinutes, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Older reports are spied again before attacking" />
                            <TextBlock Grid.Row="8" Text="Fleet slots used %" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding FleetSlotUsePercent, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="The raider fills at most this share of all fleet slots with spies and attacks" />
                            <TextBlock Grid.Row="9" Text="Speed %" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding SpeedPercentage, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="10" Text="Only rank ≤ (0 = all)" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding MaxRank, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Players are taken best ranked (most points) first; this skips players ranked below" />
                            <CheckBox Grid.Row="11" Grid.ColumnSpan="2" Content="Send from the nearest planet with cargo ships" IsChecked="{Binding UseNearestPlanet}"
                                      ToolTip="Otherwise every fleet leaves from the planet selected in the game" Margin="0,0,0,6" />
                        </Grid>

                        <CheckBox Content="Test mode (don't send fleets)" IsChecked="{Binding TestMode}" Margin="0,0,0,6" FontWeight="SemiBold"
                                  ToolTip="Start, Spy selected and Attack selected only read the game and log what they would send" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Start" Command="{Binding RunCommand}"
                                    ToolTip="Read reports, attack ready planets, spy on the next ones, and repeat as fleets return" />
                            <Button Content="Stop" Command="{Binding RunCancelCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Log}" MinHeight="60" />
                </DockPanel>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</UserControl>
